MODE="development"

# Storage backend for link sharing (self-hosted)
VITE_APP_BACKEND_V2_GET_URL=http://localhost:8080/api/v2/scenes/
VITE_APP_BACKEND_V2_POST_URL=http://localhost:8080/api/v2/scenes/

# Collaboration WebSocket server (self-hosted excalidraw-room)
VITE_APP_WS_SERVER_URL=http://localhost:3002

# Libraries (still use official — these are public community libraries)
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

# Disable Firebase (no server-side user persistence, drawings persist in browser IndexedDB)
VITE_APP_FIREBASE_CONFIG={}

# HTTP storage backend for collaboration persistence and file uploads (self-hosted)
VITE_APP_HTTP_STORAGE_BACKEND_URL=http://localhost:8080/api/v2

# Disable tracking, Sentry, AI
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true
VITE_APP_AI_BACKEND=

# Plus features (disabled for self-hosted)
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=

# Dev server port (used by `yarn start`)
VITE_APP_PORT=3001

# Debug flags
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=
VITE_APP_COLLAPSE_OVERLAY=true
VITE_APP_ENABLE_ESLINT=true
VITE_APP_ENABLE_PWA=false
VITE_APP_DEV_DISABLE_LIVE_RELOAD=
VITE_APP_DISABLE_PREVENT_UNLOAD=

FAST_REFRESH=false
