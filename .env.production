MODE="production"

# Storage backend for link sharing (self-hosted)
VITE_APP_BACKEND_V2_GET_URL=https://draw.guneet.xyz/api/v2/scenes/
VITE_APP_BACKEND_V2_POST_URL=https://draw.guneet.xyz/api/v2/scenes/

# Collaboration WebSocket server (self-hosted, proxied via Caddy on same domain)
VITE_APP_WS_SERVER_URL=https://draw.guneet.xyz

# Libraries (use official public community libraries)
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

# Disable Firebase
VITE_APP_FIREBASE_CONFIG={}

# HTTP storage backend for collaboration persistence and file uploads (self-hosted)
VITE_APP_HTTP_STORAGE_BACKEND_URL=https://draw.guneet.xyz/api/v2

# Disable tracking, Sentry, AI
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true
VITE_APP_AI_BACKEND=

# Plus features (disabled for self-hosted)
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=

# Debug flags
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
VITE_APP_ENABLE_ESLINT=false
